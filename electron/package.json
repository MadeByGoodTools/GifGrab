{
  "name": "gifgrab",
  "version": "0.3.2",
  "description": "Cross-platform batch animation collector and converter",
  "main": "main.js",
  "author": "Good Tools",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac zip --arm64",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "ca.goodtools.gifgrab",
    "productName": "GifGrab",
    "asar": true,
    "files": ["main.js", "ui/**/*", "package.json"],
    "extraResources": [{"from": "resources/ffmpeg", "to": "ffmpeg"}],
    "mac": {"category": "public.app-category.utilities", "target": ["zip"], "icon": "resources/GifGrab.icns"},
    "win": {"target": ["nsis"], "artifactName": "GoodTools-Installer-GifGrab-${version}-Windows-${arch}.${ext}", "icon": "resources/GifGrab.ico"},
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GifGrab",
      "uninstallDisplayName": "GifGrab - Good Tools",
      "deleteAppDataOnUninstall": false
    }
  }
}
