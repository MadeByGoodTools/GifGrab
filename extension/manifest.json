{
  "manifest_version": 3,
  "name": "GifGrab Collector",
  "version": "0.3.2",
  "description": "Collect animations from thumbnail grids and send them to the GifGrab desktop queue.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://*/*", "http://*/*", "http://127.0.0.1:17878/*"],
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "action": {"default_popup": "popup.html", "default_title": "GifGrab", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}
}
