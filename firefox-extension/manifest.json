{
  "manifest_version": 3,
  "name": "GifGrab Collector for Firefox",
  "version": "0.3.3",
  "description": "The Firefox edition of GifGrab Collector for animation grids and detail pages.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://*/*", "http://*/*", "http://127.0.0.1:17878/*"],
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "action": {"default_popup": "popup.html", "default_title": "GifGrab", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}},
  "browser_specific_settings": {
    "gecko": {
      "id": "gifgrab@goodtools.ca",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["browsingActivity", "websiteContent"]
      }
    }
  }
}
